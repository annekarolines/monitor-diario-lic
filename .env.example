# Renomeie para .env e preencha com suas credenciais reais

# Gemini API — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Portal da Transparência — https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Limites: 400 req/min (horário comercial) | 180 req/min (APIs restritas)
# O script usa 120 req/min como margem segura.
TRANSPARENCIA_API_KEY=sua_chave_aqui
